{
  "rules": {
    "apps": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["category", "timestamp", "downloads", "name"]
    },
    "banners": {
      ".read": true,
      ".write": "auth != null"
    },
    "news": {
      ".read": true,
      ".write": "auth != null"
    },
    "requests": {
      ".read": "auth != null",
      ".write": true
    },
    "update_reports": {
      ".read": "auth != null",
      ".write": true
    },
    "visitors": {
      ".read": "auth != null",
      ".write": true
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && data.child(auth.uid).child('role').val() === 'super' || !data.exists()"
    },
    "config": {
      ".read": true,
      ".write": false
    }
  }
}
