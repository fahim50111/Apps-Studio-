rules_version = '2';

// Apps Studio — Firestore Security Rules
// Collections: apps, banners, news, requests, update_reports, visitors, admins
//
// Public website needs:
//   - read: apps, banners, news, requests
//   - update: apps.downloads +1 only
//   - write: requests (submit + public board)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function onlyDownloadsBumped() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads is number
        && (
          (resource.data.downloads is number
            && request.resource.data.downloads == resource.data.downloads + 1)
          || (!(resource.data.downloads is number)
            && request.resource.data.downloads == 1)
        );
    }

    // -------------------- apps --------------------
    match /apps/{docId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
      // Auth = full update; public = downloads +1 only
      allow update: if isSignedIn() || onlyDownloadsBumped();
    }

    // -------------------- banners --------------------
    match /banners/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------- news --------------------
    match /news/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Legacy announcements (older builds)
    match /admin_notifications/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------- requests (public board) --------------------
    // Fields: date(string), name(string), status(string), text(string), timestamp(number)
    match /requests/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // -------------------- update_reports --------------------
    match /update_reports/{docId} {
      allow read: if isSignedIn();
      allow write: if true;
    }

    // -------------------- visitors --------------------
    match /visitors/{docId} {
      allow read: if isSignedIn();
      allow write: if true;
    }

    // -------------------- admins --------------------
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
