rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /apps/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /requests/{docId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /update_reports/{docId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /visitors/{docId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
