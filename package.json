{
  "name": "apps-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc -b && npx vite build",
    "lint": "npx eslint .",
    "preview": "npx vite preview",
    "firebase:login": "firebase login",
    "firebase:build": "npm run build",
